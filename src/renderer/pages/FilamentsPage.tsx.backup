import React, { useState, useCallback } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import type { Filament, Config } from '../../main/types';
import { validateFilament, formatErrorMessage } from '../utils/validation';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from '@/components/ui/dialog';
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from '@/components/ui/table';
import { useToast } from '@/hooks/use-toast';
import { Plus, Edit, Trash2 } from 'lucide-react';

export const FilamentsPage: React.FC = () => {
  const queryClient = useQueryClient();
  const { toast } = useToast();
  const [showDialog, setShowDialog] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [confirmDelete, setConfirmDelete] = useState<{show: boolean, id: string | null}>({show: false, id: null});
  const [formData, setFormData] = useState<Partial<Filament>>({
    name: '',
    pricePerKg: 0,
    riskFactor: 0.1,
  });
  const [formErrors, setFormErrors] = useState<Map<string, string>>(new Map());

  // Fetch all filaments
  const { data: config, isLoading, error } = useQuery({
    queryKey: ['config'],
    queryFn: async () => {
      try {
        const result = await window.electron.config.getConfig();
        return result as Config;
      } catch (err) {
        throw new Error(formatErrorMessage(err));
      }
    },
  });

  // Add/Update filament mutation
  const saveMutation = useMutation({
    mutationFn: async (filament: Partial<Filament>) => {
      // Validar antes de salvar
      const errors = validateFilament(filament);
      if (errors.length > 0) {
        const errMap = new Map(errors.map((e) => [e.field, e.message]));
        setFormErrors(errMap);
        throw new Error(errors.map((e) => e.message).join(', '));
      }

      try {
        if (editingId) {
          await window.electron.config.updateFilament(editingId, filament as Filament);
        } else {
          const newId = `fil_${Date.now()}`;
          await window.electron.config.addFilament({
            id: newId,
            ...filament,
          } as Filament);
        }
      } catch (err) {
        throw new Error(formatErrorMessage(err));
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['config'] });
      toastRef.current?.show({
        severity: 'success',
        summary: editingId ? 'Filamento atualizado' : 'Filamento criado',
        detail: editingId
          ? 'O filamento foi atualizado com sucesso!'
          : 'O novo filamento foi adicionado com sucesso!',
        life: 3000,
      });
      handleCloseDialog();
    },
    onError: (error) => {
      toastRef.current?.show({
        severity: 'error',
        summary: 'Erro ao salvar',
        detail: error instanceof Error ? error.message : 'Erro desconhecido',
        life: 4000,
      });
    },
  });

  // Delete filament mutation
  const deleteMutation = useMutation({
    mutationFn: async (id: string) => {
      try {
        await window.electron.config.deleteFilament(id);
      } catch (err) {
        throw new Error(formatErrorMessage(err));
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['config'] });
      toastRef.current?.show({
        severity: 'success',
        summary: 'Filamento deletado',
        detail: 'O filamento foi removido com sucesso!',
        life: 3000,
      });
    },
    onError: (error) => {
      toastRef.current?.show({
        severity: 'error',
        summary: 'Erro ao deletar',
        detail: error instanceof Error ? error.message : 'Erro desconhecido',
        life: 4000,
      });
    },
  });

  const handleOpenDialog = (filament?: Filament) => {
    if (filament) {
      setEditingId(filament.id);
      setFormData(filament);
    } else {
      setEditingId(null);
      setFormData({
        name: '',
        pricePerKg: 0,
        riskFactor: 0.1,
      });
    }
    setFormErrors(new Map());
    setShowDialog(true);
  };

  const handleCloseDialog = () => {
    setShowDialog(false);
    setEditingId(null);
    setFormData({
      name: '',
      pricePerKg: 0,
      riskFactor: 0.1,
    });
    setFormErrors(new Map());
  };

  const handleSave = () => {
    // Validar localmente primeiro
    const errors = validateFilament(formData);
    if (errors.length > 0) {
      const errMap = new Map(errors.map((e) => [e.field, e.message]));
      setFormErrors(errMap);
      toastRef.current?.show({
        severity: 'warn',
        summary: 'Campos inválidos',
        detail: errors.map((e) => e.message).join(', '),
        life: 3000,
      });
      return;
    }

    setFormErrors(new Map());
    saveMutation.mutate(formData);
  };

  const handleDelete = (filament: Filament) => {
    confirmDialog({
      message: `Tem certeza que deseja deletar o filamento "${filament.name}"?`,
      header: 'Confirmar exclusão',
      icon: 'pi pi-exclamation-triangle',
      accept: () => deleteMutation.mutate(filament.id),
      reject: () => {},
    });
  };

  const actionTemplate = (rowData: Filament) => (
    <div className="flex gap-2">
      <StyledButton
        icon="pi pi-pencil"
        rounded
        text
        severity="info"
        onClick={() => handleOpenDialog(rowData)}
        tooltip="Editar"
      />
      <StyledButton
        icon="pi pi-trash"
        rounded
        text
        severity="danger"
        onClick={() => handleDelete(rowData)}
        tooltip="Deletar"
      />
    </div>
  );

  const priceTemplate = (rowData: Filament) => `R$ ${rowData.pricePerKg.toFixed(2)}/kg`;

  const riskTemplate = (rowData: Filament) => `${(rowData.riskFactor * 100).toFixed(1)}%`;

  if (isLoading) {
    return (
      <div className="p-6">
        <Message severity="info" text="Carregando filamentos..." />
      </div>
    );
  }

  if (error || !config) {
    return (
      <div className="p-6">
        <Message severity="error" text={formatErrorMessage(error)} />
      </div>
    );
  }

  return (
    <div className="p-6 space-y-6">
      <Toast ref={toastRef} />
      <ConfirmDialog />

      <div className="flex justify-between items-center">
        <h1 className="text-3xl font-bold text-gray-800">Gerenciar Filamentos</h1>
        <StyledButton
          icon="pi pi-plus"
          label="Novo Filamento"
          onClick={() => handleOpenDialog()}
          className="bg-blue-600 hover:bg-blue-700"
        />
      </div>

      <Card className="shadow-lg">
        {config.filaments.length === 0 ? (
          <Message severity="info" text="Nenhum filamento cadastrado. Clique em 'Novo Filamento' para começar!" />
        ) : (
          <DataTable value={config.filaments} rows={10} paginator className="p-datatable-sm">
            <Column field="name" header="Nome" sortable filter />
            <Column
              field="pricePerKg"
              header="Preço"
              body={priceTemplate}
              sortable
              style={{ width: '150px' }}
            />
            <Column
              field="riskFactor"
              header="Fator Risco"
              body={riskTemplate}
              sortable
              style={{ width: '120px' }}
            />
            <Column body={actionTemplate} style={{ width: '100px', textAlign: 'center' }} />
          </DataTable>
        )}
      </Card>

      <Dialog
        visible={showDialog}
        onHide={handleCloseDialog}
        header={editingId ? 'Editar Filamento' : 'Novo Filamento'}
        modal
        style={{ width: '90vw', maxWidth: '500px' }}
      >
        <div className="p-4 space-y-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">Nome*</label>
            <InputText
              value={formData.name || ''}
              onChange={(e: React.ChangeEvent<HTMLInputElement>) => {
                setFormData({ ...formData, name: e.target.value });
                const newErrors = new Map(formErrors);
                newErrors.delete('name');
                setFormErrors(newErrors);
              }}
              placeholder="Ex: PLA Branco"
              className={`w-full ${formErrors.has('name') ? 'border-red-500' : ''}`}
            />
            {formErrors.has('name') && (
              <p className="text-xs text-red-500 mt-1">{formErrors.get('name')}</p>
            )}
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">Preço por kg (R$)*</label>
            <InputNumber
              value={formData.pricePerKg}
              onValueChange={(e: InputNumberValueChangeEvent) => {
                setFormData({ ...formData, pricePerKg: e.value || 0 });
                const newErrors = new Map(formErrors);
                newErrors.delete('pricePerKg');
                setFormErrors(newErrors);
              }}
              min={0}
              step={0.01}
              placeholder="0.00"
              className={`w-full ${formErrors.has('pricePerKg') ? 'border-red-500' : ''}`}
              prefix="R$ "
            />
            {formErrors.has('pricePerKg') && (
              <p className="text-xs text-red-500 mt-1">{formErrors.get('pricePerKg')}</p>
            )}
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">Fator de Risco (0-1)*</label>
            <InputNumber
              value={formData.riskFactor}
              onValueChange={(e: InputNumberValueChangeEvent) => {
                setFormData({ ...formData, riskFactor: e.value || 0 });
                const newErrors = new Map(formErrors);
                newErrors.delete('riskFactor');
                setFormErrors(newErrors);
              }}
              min={0}
              max={1}
              step={0.01}
              placeholder="0.1"
              className={`w-full ${formErrors.has('riskFactor') ? 'border-red-500' : ''}`}
            />
            <p className="text-xs text-gray-500 mt-1">Entre 0 e 1 (ex: 0.1 = 10% de risco)</p>
            {formErrors.has('riskFactor') && (
              <p className="text-xs text-red-500 mt-1">{formErrors.get('riskFactor')}</p>
            )}
          </div>

          <div className="flex gap-4 pt-6 space-x-1">
            <StyledButton
              label="Cancelar"
              icon="pi pi-times"
              onClick={handleCloseDialog}
              severity="secondary"
              className="flex-1"
            />
            <StyledButton
              label={editingId ? 'Atualizar' : 'Criar'}
              icon={editingId ? 'pi pi-check' : 'pi pi-plus'}
              onClick={handleSave}
              className="flex-1"
            />
          </div>
        </div>
      </Dialog>
    </div>
  );
};
