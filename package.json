{
  "name": "impressoes-3d-calc",
  "version": "1.0.0",
  "description": "Calculadora de custos de impressão 3D - Electron + React",
  "author": "Luiz Miguel",
  "license": "MIT",
  "main": "dist/main/index.js",
  "homepage": "./",
  "scripts": {
    "dev": "pnpm build:electron && node dev-server.js",
    "dev:react": "webpack serve --config webpack.react.js --mode development --port 3000",
    "dev:electron": "cross-env NODE_ENV=development electron dist/main/index.js",
    "start": "electron dist/main/index.js",
    "build": "pnpm build:electron && pnpm build:react",
    "build:react": "webpack --config webpack.react.js --mode production",
    "build:electron": "tsc --project tsconfig.electron.json",
    "pack": "pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir",
    "dist:win": "pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "build": {
    "appId": "com.luizmiguel.impressoes3dcalc",
    "productName": "Impressões 3D Calc",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/electron-store/**/*",
      "node_modules/electron-is-dev/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^8.1.0",
    "lucide-react": "^1.14.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/html-webpack-plugin": "^3.2.9",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "electron": "^42.0.1",
    "electron-builder": "^24.6.4",
    "eslint": "^8.50.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^29.5.0",
    "postcss": "^8.5.14",
    "postcss-loader": "^8.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  }
}
